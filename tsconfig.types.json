  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./types",
    "rootDir": "./src",
    "skipLibCheck": true,
    "target": "ES2024"
  },
  "include": ["./src/index.js"]
}
