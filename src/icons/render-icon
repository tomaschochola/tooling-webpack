#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  printf '%s\n' 'Usage: render-icon SOURCE OUTPUT CANVAS_SIZE CONTENT_SIZE BACKGROUND' >&2
  printf '%s\n' 'The CONTENT_SIZE image is centered on the CANVAS_SIZE square.' >&2
  printf '%s\n' 'BACKGROUND may be a CSS color or "transparent".' >&2
  exit 2
}

fail() {
  printf 'render-icon: %s\n' "$1" >&2
  exit 1
}

verify_png_size() {
  local path="$1"
  local expected_size="$2"
  local signature
  local width
  local height

  signature="$(od -An -tx1 -N8 -- "$path" | tr -d '[:space:]')"
  [[ "$signature" == '89504e470d0a1a0a' ]] || fail "output is not a PNG file: $path"

  read -r width height < <(od -An -tu4 --endian=big -j16 -N8 -- "$path")
  [[ "$width" == "$expected_size" && "$height" == "$expected_size" ]] || fail "expected ${expected_size}x${expected_size}, got ${width}x${height}: $path"
}

[[ "$#" -eq 5 ]] || usage

source_path="$1"
output_path="$2"
canvas_size="$3"
content_size="$4"
background="$5"

[[ -f "$source_path" ]] || fail "source does not exist: $source_path"
[[ "$canvas_size" =~ ^[1-9][0-9]*$ ]] || fail 'CANVAS_SIZE must be a positive integer'
[[ "$content_size" =~ ^[1-9][0-9]*$ ]] || fail 'CONTENT_SIZE must be a positive integer'
((content_size <= canvas_size)) || fail 'CONTENT_SIZE must not exceed CANVAS_SIZE'
command -v sharp >/dev/null || fail 'sharp-cli is required'
command -v od >/dev/null || fail 'od is required'

extension="${source_path##*.}"
extension="${extension,,}"

case "$extension" in
svg)
  command -v resvg >/dev/null || fail 'resvg is required for SVG input'
  ;;
jpeg | jpg | png)
  ;;
*)
  fail 'SOURCE must be an SVG, PNG, JPEG, or JPG file'
  ;;
esac

output_directory="$(dirname -- "$output_path")"
mkdir -p -- "$output_directory"

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT

prepared="$source_path"
rendered="$work/rendered.png"
result="$work/result.png"

if [[ "$extension" == 'svg' ]]; then
  prepared="$work/prepared.png"
  resvg --width "$content_size" --height "$content_size" "$source_path" "$prepared"
fi

sharp \
  --input "$prepared" \
  --output "$rendered" \
  --autoOrient \
  --format png \
  --compressionLevel 9 \
  --adaptiveFiltering \
  resize "$content_size" "$content_size" \
  --fit contain \
  --background 'rgba(0, 0, 0, 0)' \
  -- \
  toColorspace srgb \
  >/dev/null

padding="$((canvas_size - content_size))"
padding_before="$((padding / 2))"
padding_after="$((padding - padding_before))"

if [[ "$background" == 'transparent' ]]; then
  sharp \
    --input "$rendered" \
    --output "$result" \
    --format png \
    --compressionLevel 9 \
    --adaptiveFiltering \
    extend "$padding_before" "$padding_after" "$padding_before" "$padding_after" \
    --background 'rgba(0, 0, 0, 0)' \
    -- \
    toColorspace srgb \
    >/dev/null
else
  sharp \
    --input "$rendered" \
    --output "$result" \
    --format png \
    --compressionLevel 9 \
    --adaptiveFiltering \
    extend "$padding_before" "$padding_after" "$padding_before" "$padding_after" \
    --background "$background" \
    -- \
    flatten "$background" \
    -- \
    toColorspace srgb \
    >/dev/null
fi

verify_png_size "$result" "$canvas_size"
mv -f -- "$result" "$output_path"
