#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  printf '%s\n' 'Usage: generate-icons SOURCE OUTPUT_DIRECTORY STYLE BACKGROUND' >&2
  printf '%s\n' 'symbol adds safe padding to install icons; fullbleed treats the source as finished square artwork.' >&2
  exit 2
}

fail() {
  printf 'generate-icons: %s\n' "$1" >&2
  exit 1
}

[[ "$#" -eq 4 ]] || usage

source_path="$1"
output_directory="$2"
style="$3"
background="$4"

[[ -f "$source_path" ]] || fail "source does not exist: $source_path"

case "$style" in
fullbleed | symbol)
  ;;
*)
  fail 'STYLE must be "symbol" or "fullbleed"'
  ;;
esac

command -v icotool >/dev/null || fail 'icotool is required'
command -v sharp >/dev/null || fail 'sharp-cli is required'

script_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
renderer="$script_directory/render-icon"
[[ -x "$renderer" ]] || fail "renderer is not executable: $renderer"

extension="${source_path##*.}"
extension="${extension,,}"

case "$extension" in
svg)
  command -v resvg >/dev/null || fail 'resvg is required for SVG input'
  command -v svgo >/dev/null || fail 'svgo is required for SVG input'
  ;;
jpeg | jpg | png)
  ;;
*)
  fail 'SOURCE must be an SVG, PNG, JPEG, or JPG file'
  ;;
esac

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT

stage="$work/output"
mkdir -p -- "$stage"

render_source="$source_path"

if [[ "$extension" == 'svg' ]]; then
  svgo --multipass --quiet --input "$source_path" --output "$stage/favicon.svg"
  render_source="$stage/favicon.svg"
fi

for size in 16 32 48; do
  "$renderer" "$render_source" "$work/favicon-${size}x${size}.png" "$size" "$size" transparent
done

icotool \
  --create \
  --output "$stage/favicon.ico" \
  "$work/favicon-16x16.png" \
  "$work/favicon-32x32.png" \
  "$work/favicon-48x48.png"

"$renderer" "$render_source" "$stage/favicon-96x96.png" 96 96 transparent

normal_content_size() {
  local size="$1"

  if [[ "$style" == 'fullbleed' ]]; then
    printf '%s\n' "$size"
    return
  fi

  local padding="$(((size + 5) / 10))"
  printf '%s\n' "$((size - 2 * padding))"
}

maskable_content_size() {
  local size="$1"

  if [[ "$style" == 'fullbleed' ]]; then
    printf '%s\n' "$size"
    return
  fi

  # A 9/16 square fits inside the maskable safe-zone circle (radius 2/5).
  printf '%s\n' "$((size * 9 / 16))"
}

"$renderer" "$render_source" "$stage/apple-touch-icon.png" 180 "$(normal_content_size 180)" "$background"

for size in 192 512 1024; do
  "$renderer" "$render_source" "$stage/icon-${size}x${size}.png" "$size" "$(normal_content_size "$size")" "$background"
  "$renderer" "$render_source" "$stage/maskable-icon-${size}x${size}.png" "$size" "$(maskable_content_size "$size")" "$background"
done

mkdir -p -- "$output_directory"

if [[ ! -f "$stage/favicon.svg" ]]; then
  rm -f -- "$output_directory/favicon.svg"
fi

mv -f -- "$stage/"* "$output_directory/"

if [[ "$extension" != 'svg' ]]; then
  printf '%s\n' 'generate-icons: raster input cannot produce a vector favicon.svg; the PNG and ICO favicon set was generated.' >&2
fi
